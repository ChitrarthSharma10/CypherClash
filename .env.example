# Frontend environment variables (used by Vite at build time)
#
# VITE_API_URL controls where the frontend sends API requests.
#
# Development (local):
#   VITE_API_URL=http://localhost:4000
#
# Production (deployed behind Nginx reverse-proxy at cyber-clash.duckdns.org):
#   Leave VITE_API_URL empty so the app uses relative paths like /api/…
#   which Nginx proxies to the local backend. This avoids any CORS issues.
#   VITE_API_URL=
#
VITE_API_URL=http://localhost:4000
