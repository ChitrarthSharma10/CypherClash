MONGO_URI=mongodb://127.0.0.1:27017/cypherclash
MONGO_URI_TEST=mongodb://127.0.0.1:27017/cypherclash_test
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-chars
# In development, Vite runs on http://localhost:5173 (or 5177 / 5157)
# In production, set to your domain(s): FRONTEND_ORIGIN=https://cyber-clash.duckdns.org
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5177,http://localhost:5157
PORT=4000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=0
BCRYPT_COST=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-strong-admin-password
# Set to true when you want npm run seed to create three sample teams.
SEED_SAMPLE_TEAMS=false
# Dedicated public GitHub challenge repository URL for Round 2 Lead 3
INVESTIGATION_LEAD3_GITHUB_URL=https://github.com/DDuggad/CyberHint
