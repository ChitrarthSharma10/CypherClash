MONGO_URI=mongodb://127.0.0.1:27017/cypherclash
MONGO_URI_TEST=mongodb://127.0.0.1:27017/cypherclash_test
SESSION_SECRET=generate-a-random-secret-at-least-32-characters
# In development, Vite runs on http://localhost:5157 (or 5173 by default)
FRONTEND_ORIGIN=http://localhost:5157
PORT=4000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=0
BCRYPT_COST=10
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-unique-admin-password
# Set to true when you want npm run seed to create three sample teams.
SEED_SAMPLE_TEAMS=false
